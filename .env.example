# === TELEGRAM (user account - MTProto) ===
# Ia-le de pe https://my.telegram.org -> API Development Tools
TG_API_ID=
TG_API_HASH=

TG_SESSION=

# Username-urile canalelor monitorizate (fara @, doar username-ul din linkul
# canalului: t.me/G4Media -> G4Media). Nu conteaza majusculele, botul
# normalizeaza automat.
# Daca un canal tot nu e detectat, ruleaza botul si uita-te in consola la liniile
# "[mesaj primit] de la: ..." ca sa vezi EXACT ce username citeste Telegram.
CHANNELS=

# Canale care OCOLESC toate filtrele de continut (similaritate, keywords,
# stiri straine). Foloseste-l pentru canalul TAU de rezerva, unde vrei sa
# pui orice daca da prost. Ramane activ doar deduplicarea de URL.
BYPASS_CHANNELS=

# === BOT-UL CARE ITI TRIMITE TIE PRIVAT (Bot API normal, separat de contul tau) ===
# Creat cu @BotFather, comanda /newbot
NOTIFY_BOT_TOKEN=
# ID-ul tau de Telegram (afla-l de la @userinfobot)
NOTIFY_CHAT_ID=

# === GEMINI ===
GEMINI_API_KEY=

# === TAVILY (cautare imagini) ===
TAVILY_API_KEY=

# === CONFIG ===
# Prag similaritate (0.85 = 85%).
SIMILARITY_THRESHOLD=0.85
HISTORY_HOURS=72
# Cate zile se evita reutilizarea unei imagini (7 = o saptamana)
IMAGE_HISTORY_DAYS=7

KEYWORDS=

ROMANIAN_PERSONALITIES=

# === PERSISTARE BAZA DE DATE (doar pe GitHub Actions) ===
# Botul salveaza data.sqlite periodic in branch-ul dat, ca istoricul de 72h sa
# nu se piarda intre rulari (pe Actions filesystem-ul e efemer). Local se lasa
# gol - DB-ul local ramane oricum pe disc.
DB_PERSIST_BRANCH=
# La cate minute salveaza (cat mai des = mai putin de pierdut la oprire forțată)
DB_PERSIST_INTERVAL_MIN=5
