# === TELEGRAM (user account - MTProto) ===
# Ia-le de pe https://my.telegram.org -> API Development Tools
TG_API_ID=
TG_API_HASH=
# Se genereaza automat dupa primul login (npm run login), NU le pune manual
TG_SESSION=

# Username-urile canalelor monitorizate (fara @, doar username-ul din linkul
# canalului: t.me/G4Media -> G4Media). Nu conteaza majusculele, botul
# normalizeaza automat.
# Daca un canal tot nu e detectat, ruleaza botul si uita-te in consola la liniile
# "[mesaj primit] de la: ..." ca sa vezi EXACT ce username citeste Telegram.
CHANNELS=g4media,digi24RO,mediafax,hotnewsRO,gtasixleak

# Canale care OCOLESC complet filtrul de similaritate (nu se compara, nu se
# blocheaza nimic). Foloseste-l pentru canalul TAU de rezerva, unde vrei sa
# poti pune orice daca da prost.
BYPASS_SIMILARITY_CHANNELS=gtasixleak

# === BOT-UL CARE ITI TRIMITE TIE PRIVAT (Bot API normal, separat de contul tau) ===
# Creat cu @BotFather, comanda /newbot
NOTIFY_BOT_TOKEN=
# ID-ul tau de Telegram (afla-l de la @userinfobot)
NOTIFY_CHAT_ID=

# === GEMINI ===
GEMINI_API_KEY=

# === TAVILY (cautare imagini) ===
TAVILY_API_KEY=

# === CONFIG ===
# Prag similaritate pentru "aceeasi stire" (0.80 = 80%). Se compara titlul +
# primul paragraf, DOAR intre site-uri DIFERITE (pe acelasi site nu se verifica,
# un site nu isi republiceaza singur stirea).
SIMILARITY_THRESHOLD=0.80
HISTORY_HOURS=72
# Cate zile se evita reutilizarea unei imagini (7 = o saptamana)
IMAGE_HISTORY_DAYS=7

KEYWORDS=PNL,USR,Ilie Bolojan,Bolojan,premier,Nicusor Dan,Nicușor Dan,Dominic Fritz,Fritz,Diana Buzoianu,Buzoianu,ministru,ministrul

# Personalitati romanesti REALE (doar numele, fara cuvinte generice). Folosite
# la filtrul de stiri straine: o stire din alta tara e acceptata DOAR daca
# mentioneaza una dintre aceste persoane. "ministrul"/"premierul" NU conteaza
# (apar si in stiri straine, ex. "ministrul federal Carsten Schneider").
ROMANIAN_PERSONALITIES=Ilie Bolojan,Bolojan,Nicusor Dan,Nicușor Dan,Dominic Fritz,Fritz,Diana Buzoianu,Buzoianu
